{
    "name": "horde/logintasks",
    "description": "Login tasks library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_LoginTasks",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
